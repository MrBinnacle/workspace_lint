# workspace_lint — 72-hour proof fixture
# Built 2026-08-17. Pages created via the claude.ai Notion connector.
# .env is gitignored. Never commit this file.

NOTION_TOKEN=
NOTION_VERSION=2026-03-11

# Declared root. Connect workspace-lint-proof to THIS page only.
FIXTURE_ROOT_ID=

# Q7 — 151 blocks (150 fixture + 1 intro), so block-children must paginate.
PAGINATION_PAGE_ID=

# Q2, Q3 — 150 rows. Query the DATA SOURCE id; the database id is for reference.
FIXTURE_DS_ID=
FIXTURE_DB_ID=
TYPE_CHANGE_PROP=Status

# Q1, Q6 — revocation probe. REVOCATION_SUPPORTED is answered by a human only.
REVOKE_PARENT_ID=
REVOKE_CHILD_ID=
REVOCATION_SUPPORTED=

# Contrast case — never connect the integration to this page.
UNSHARED_PAGE_ID=

# Q8 — optional. A real workspace root, if you want disclaimed-frequency measured.
REAL_ROOT_ID=
