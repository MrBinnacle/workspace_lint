# No toolchain is chosen yet. This file covers Node, Python, and Rust.
# Delete the sections that do not apply once the stack is settled.

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editors ---
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*~

# --- Secrets and local environment ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Proof-fixture scratch (setup-proof-fixture.sh writes these, then deletes
# them at its last stage; these lines cover a Ctrl-C mid-run) ---
.proof-fixture-blocks.txt
.proof-fixture-rows.csv

# --- Agent scratch space ---
.scratch/
.claude/settings.local.json

# .claude/state/ is NOT scratch and is deliberately tracked.
# checkpoint.md, store.json, gate_events.jsonl and retrospection.jsonl are
# the canonical surfaces the session-start ritual reads. Ignoring them made
# session state survive only on one machine, which defeats the ritual and
# loses the decision history. Keep them in git.
.claude/state/tmp/

